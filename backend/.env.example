# Copy this file to .env and fill in the values. Never commit .env.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aravinth_cabs
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173
# Secret used by the driver to read saved requests (GET /api/bookings, /api/contact)
ADMIN_API_KEY=change-this-to-a-long-random-string

# --- Customer sign-in ---
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# --- Razorpay (₹200 advance) --- keep these on the server only, never in the React app
# Dashboard -> Account & Settings -> API Keys (use rzp_test_ keys while testing)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional but recommended: secret you set when adding the webhook in the Razorpay dashboard
# (URL: https://<your-api>/api/payments/webhook, events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=
